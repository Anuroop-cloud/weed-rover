<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="farm_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Set camera position to look at the ground -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>1.5 -2.5 3.0 0 0.8 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
